            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Morning Strength Session\",\n  \"description\": \"Great leg day workout focusing on squats\",\n  \"difficulty\": \"intermediate\",\n  \"duration\": 45,\n  \"caloriesBurned\": 350,\n  \"exercises\": [\n    {\n      \"exerciseId\": \"{{exerciseId}}\",\n      \"sets\": 4,\n      \"reps\": 10,\n      \"weight\": 80\n    }\n  ]\n}"
            },
