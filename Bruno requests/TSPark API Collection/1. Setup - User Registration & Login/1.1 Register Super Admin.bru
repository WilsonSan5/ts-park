}

body:json {
  {
    "email": "superadmin@tspark.com",
    "password": "SuperAdmin123!",
    "firstName": "Super",
    "lastName": "Admin",
    "role": "super_admin"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
      var jsonData = res.getBody();
      console.log('Super Admin created:', jsonData.data.user.email);
  }
}

