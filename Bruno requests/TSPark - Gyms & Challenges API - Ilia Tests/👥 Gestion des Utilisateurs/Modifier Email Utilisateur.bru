meta {
  name: Modifier Email Utilisateur
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/users/{{gym_owner_id}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{gym_owner_token}}
}

body:json {
  {
    "email": "pierre.martin@tspark.com"
  }
}

script:post-response {
  test("Email modifié", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Nouvel email appliqué", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.user.email).to.eql('pierre.martin@tspark.com');
  });
  
  console.log("📧 Email modifié:", res.getBody().data.user.email);
}

settings {
  encodeUrl: true
}

docs {
  Modifier l'email d'un utilisateur
}
