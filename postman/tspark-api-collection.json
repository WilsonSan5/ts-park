    {
      "name": "2. Auth Features (NEW)",
      "item": [
        {
          "name": "Email Verification",
          "item": [
            {
              "name": "2.1 Verify Email (with token)",
              "request": {
                "method": "GET",
                "header": [],
                "description": "Verify email address using the token sent via email.\n\n**Note**: Replace `{{emailVerificationToken}}` with actual token from registration email.",
                "url": {
                  "raw": "{{base_url}}/auth/verify-email?token={{emailVerificationToken}}",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "verify-email"],
                  "query": [
                    { "key": "token", "value": "{{emailVerificationToken}}" }
                  ]
                }
              }
            },
            {
              "name": "2.2 Resend Verification Email",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{clientToken}}" }
                ],
                "description": "Resend verification email to current authenticated user.\n\n**Requires authentication**",
                "url": {
                  "raw": "{{base_url}}/auth/resend-verification",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "resend-verification"]
                }
              }
            }
          ]
        },
        {
          "name": "Password Reset",
          "item": [
            {
              "name": "2.3 Forgot Password (Request Reset)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "description": "Request a password reset email.\n\n**Security**: Always returns success message regardless of whether email exists.",
                "url": {
                  "raw": "{{base_url}}/auth/forgot-password",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "forgot-password"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"client@tspark.com\"\n}"
                }
              }
            },
            {
              "name": "2.4 Reset Password (with token)",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "description": "Reset password using the token from reset email.\n\n**Note**: Replace `{{passwordResetToken}}` with actual token from email.",
                "url": {
                  "raw": "{{base_url}}/auth/reset-password",
                  "host": ["{{base_url}}"],
                  "path": ["auth", "reset-password"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"token\": \"{{passwordResetToken}}\",\n  \"newPassword\": \"NewPassword123!\"\n}"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Super Admin Features",
      "item": [
        {
          "name": "Exercises",
          "item": [
            {
              "name": "3.1 Create Exercise - Barbell Squat",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{superAdminToken}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "description": "**Requires Super Admin token!**\n\nCreates a new exercise.\n\n**Auto-saves** `{{exerciseId}}`",
                "url": {
                  "raw": "{{base_url}}/exercises",
                  "host": ["{{base_url}}"],
                  "path": ["exercises"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Barbell Squat\",\n  \"description\": \"Compound lower body exercise targeting quads, glutes, and hamstrings.\",\n  \"difficulty\": \"intermediate\",\n  \"muscleGroups\": [\"legs\", \"glutes\", \"core\"],\n  \"caloriesPerMinute\": 8,\n  \"instructions\": \"Stand with feet shoulder-width apart. Place barbell on upper back. Bend knees and lower hips until thighs are parallel. Push through heels to return to standing.\",\n  \"videoUrl\": \"https://example.com/squat-tutorial\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {",
                      "    var jsonData = pm.response.json();",
                      "    var id = jsonData.data.id || jsonData.data.exercise?.id;",
                      "    pm.collectionVariables.set('exerciseId', id);",
                      "    console.log('Exercise created with ID:', id);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "3.2 Create Exercise - Push-ups",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{superAdminToken}}" },
                  { "key": "Content-Type", "value": "application/json" }
