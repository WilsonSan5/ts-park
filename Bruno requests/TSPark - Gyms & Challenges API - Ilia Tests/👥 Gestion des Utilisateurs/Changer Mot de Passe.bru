meta {
  name: Changer Mot de Passe
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/users/{{client_id}}/password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{client_token}}
}

body:json {
  {
    "currentPassword": "SecurePass123",
    "newPassword": "NewSecurePassword123"
  }
}

script:post-response {
  test("Mot de passe changé", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Message de confirmation", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(true);
      expect(jsonData.message).to.include('Password changed');
  });
  
  console.log("🔒 Mot de passe changé avec succès");
}

settings {
  encodeUrl: true
}

docs {
  Changer son mot de passe (utilisateur connecté uniquement)
}
