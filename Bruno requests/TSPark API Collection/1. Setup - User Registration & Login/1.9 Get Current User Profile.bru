meta {
  name: 1.9 Get Current User Profile
  type: http
  seq: 9
}

get {
  url: {{base_url}}/auth/me
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{superAdminToken}}
}

settings {
  encodeUrl: true
}

docs {
  Test authentication by getting current user profile.
  
  Change the token in the header to test different users:
  - `{{superAdminToken}}`
  - `{{gymOwnerToken}}`
  - `{{clientToken}}`
}
