meta {
  name: Login as Super Admin
  type: http
  seq: 4
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@tspark.com",
    "password": "AdminSecure123"
  }
}

script:post-response {
  test("Status code is 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  var jsonData = res.getBody();
  if (jsonData.data && jsonData.data.token) {
      bru.setVar("admin_token", jsonData.data.token);
      console.log("✅ Admin login successful! Token saved.");
  }
}

settings {
  encodeUrl: true
}

docs {
  **Login as Super Admin**
  
  Saves admin token to test admin-only endpoints.
}
