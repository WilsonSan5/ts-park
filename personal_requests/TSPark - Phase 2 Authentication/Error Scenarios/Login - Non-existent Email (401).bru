meta {
  name: Login - Non-existent Email (401)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nonexistent@tspark.com",
    "password": "SomePassword123"
  }
}

script:post-response {
  test("Status code is 401 Unauthorized", function () {
      expect(res.getStatus()).to.equal(401);
  });
  
  test("Response indicates invalid credentials", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(false);
      expect(jsonData.message).to.include('Invalid');
  });
  
  console.log("✅ Non-existent email correctly rejected");
}

settings {
  encodeUrl: true
}

docs {
  **Test login with non-existent email**
  
  ### Expected Behavior:
  - Status: 401 Unauthorized
  - Message: "Invalid email or password" (same as wrong password)
  - No token generated
  
  ### Security:
  Same error message for wrong email and wrong password prevents email enumeration attacks.
}
