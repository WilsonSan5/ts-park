meta {
  name: Log Badge
  type: http
  seq: 1
}

post {
  url: {{base_url}}/badges
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{superAdminToken}}
}

body:json {
  {
    "name": "Big Arms Monster", 
    "description": "Earned with the completetion of 3 arms challenges" , 
    "icon": "💪", 
    "pointsValue": 150 , 
    "isActive": true 
  }
}

script:post-response {
  if (res.getStatus() === 201) {
      var jsonData = res.getBody();
      bru.setVar('badgeId', jsonData.id);
      console.log('badgeId saved');
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
