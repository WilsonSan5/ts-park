meta {
  name: Approuver une Salle (Admin)
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/gyms/{{new_gym_id}}/approve
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{admin_token}}
}

script:post-response {
  test("Approbation réussie", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Statut changé en approuvé", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.status).to.eql('approved');
  });
  
  console.log("✅ Salle approuvée:", res.getBody().data.name);
}

settings {
  encodeUrl: true
}

docs {
  Approuver une salle de sport (super_admin uniquement)
}
