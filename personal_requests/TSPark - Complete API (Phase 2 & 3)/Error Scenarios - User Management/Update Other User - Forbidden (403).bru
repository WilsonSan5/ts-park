meta {
  name: Update Other User - Forbidden (403)
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/users/00000000-0000-0000-0000-000000000000
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "firstName": "Hacker"
  }
}

script:post-response {
  test("Status code is 403 Forbidden", function () {
      expect(res.getStatus()).to.equal(403);
  });
  
  console.log("✅ User correctly blocked from updating other user's profile");
}

settings {
  encodeUrl: true
}

docs {
  **Test user trying to update another user's profile**
  
  Expected: 403 Forbidden
}
