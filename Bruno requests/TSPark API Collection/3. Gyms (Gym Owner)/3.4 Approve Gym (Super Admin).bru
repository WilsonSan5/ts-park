meta {
  name: 3.4 Approve Gym (Super Admin)
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/gyms/{{gymId}}/approve
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{superAdminToken}}
  Content-Type: application/json
}

body:json {
  {
    "isApproved": true
  }
}

settings {
  encodeUrl: true
}

docs {
  **Requires Super Admin token!**
  
  Approve a pending gym so it becomes visible to clients.
}
