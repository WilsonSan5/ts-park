meta {
  name: 1.2 Register Gym Owner
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "gymowner@tspark.com",
    "password": "GymOwner123!",
    "firstName": "Gym",
    "lastName": "Owner",
    "role": "gym_owner"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
      var jsonData = res.getBody();
      console.log('Gym Owner created:', jsonData.data.user.email);
  }
}

settings {
  encodeUrl: true
}

docs {
  Creates a Gym Owner account.
  
  Gym Owners can:
  - Create and manage their own gyms
  - Create challenges for their gyms
  - View gym members and statistics
}
