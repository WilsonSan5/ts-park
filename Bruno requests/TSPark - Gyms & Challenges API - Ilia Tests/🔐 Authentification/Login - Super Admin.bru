meta {
  name: Login - Super Admin
  type: http
  seq: 6
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@tspark.com",
    "password": "AdminSecure123"
  }
}

script:post-response {
  test("Connexion Super Admin réussie", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Rôle super_admin confirmé", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.user.role).to.eql('super_admin');
  });
  
  var jsonData = res.getBody();
  if (jsonData.data && jsonData.data.token) {
      bru.setVar("admin_token", jsonData.data.token);
      bru.setVar("admin_id", jsonData.data.user.id);
      console.log("✅ Connecté comme admin:", jsonData.data.user.email);
      console.log("👑 Privilèges super_admin activés");
  }
}

settings {
  encodeUrl: true
}

docs {
  Connexion avec privilèges super administrateur
}
