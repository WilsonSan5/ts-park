meta {
  name: 2.1 Create Exercise
  type: http
  seq: 1
}

post {
  url: {{base_url}}/exercises
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{superAdminToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Barbell Squat",
    "description": "Compound lower body exercise targeting quads, glutes, and hamstrings. Essential for building lower body strength.",
    "type": "strength",
    "difficulty": "intermediate",
    "muscleGroup": "legs",
    "equipment": "barbell",
    "instructions": [
      "Stand with feet shoulder-width apart",
      "Place barbell on upper back (trapezius)",
      "Bend knees and lower hips until thighs are parallel to ground",
      "Keep chest up and back straight throughout",
      "Push through heels to return to standing"
    ],
    "caloriesPerMinute": 8,
    "videoUrl": "https://example.com/squat-tutorial"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
      var jsonData = res.getBody();
      bru.setVar('exerciseId', jsonData.data.id || jsonData.data.exercise.id);
      console.log('Exercise created with ID:', bru.getVar('exerciseId'));
  }
}

settings {
  encodeUrl: true
}

docs {
  **Requires Super Admin token!**
  
  Creates a new exercise in the platform.
  
  **Auto-saves exercise ID** to `{{exerciseId}}`
}
