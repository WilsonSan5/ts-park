meta {
  name: Register - Short Password (400)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "test@tspark.com",
    "password": "short",
    "firstName": "Test",
    "lastName": "User"
  }
}

script:post-response {
  test("Status code is 400 Bad Request", function () {
      expect(res.getStatus()).to.equal(400);
  });
  
  test("Response indicates password too short", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(false);
      expect(jsonData.message).to.include('8 characters');
  });
  
  console.log("✅ Short password correctly rejected");
}

settings {
  encodeUrl: true
}

docs {
  **Test registration with password too short**
  
  Password less than 8 characters should return 400 Bad Request.
  
  ### Expected Behavior:
  - Status: 400 Bad Request
  - Message: "Password must be at least 8 characters long"
  - No user created
  
  ### Security:
  Minimum password length helps prevent weak passwords and brute force attacks.
}
