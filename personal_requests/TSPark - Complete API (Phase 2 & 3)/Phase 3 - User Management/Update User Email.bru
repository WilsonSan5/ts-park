meta {
  name: Update User Email
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/users/{{user_id}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "email": "john.updated@tspark.com"
  }
}

script:post-response {
  test("Status code is 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Email updated successfully", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.user.email).to.eql('john.updated@tspark.com');
  });
  
  var jsonData = res.getBody();
  if (jsonData.data && jsonData.data.user) {
      bru.setVar("user_email", jsonData.data.user.email);
  }
  
  console.log("✅ Email updated successfully");
}

settings {
  encodeUrl: true
}

docs {
  **Update user email**
  
  **Validation:**
  - Email must be valid format
  - Email must be unique (409 if duplicate)
}
