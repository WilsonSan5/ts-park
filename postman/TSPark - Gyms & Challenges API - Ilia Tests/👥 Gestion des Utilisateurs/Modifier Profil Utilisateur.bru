meta {
  name: Modifier Profil Utilisateur
  type: http
  seq: 3
}

patch {
  url: {{base_url}}/users/{{gym_owner_id}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{gym_owner_token}}
}

body:json {
  {
    "firstName": "Pierre",
    "lastName": "Martin"
  }
}

script:post-response {
  test("Profil modifié", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Changements appliqués", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.user.firstName).to.eql('Pierre');
  });
  
  console.log("✏️ Profil modifié:", res.getBody().data.user.firstName, res.getBody().data.user.lastName);
}

settings {
  encodeUrl: true
}

docs {
  Modifier son propre profil ou celui d'un autre utilisateur (admin)
}
