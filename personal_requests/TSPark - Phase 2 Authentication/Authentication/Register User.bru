meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "john.doe@tspark.com",
    "password": "SecurePass123",
    "firstName": "John",
    "lastName": "Doe",
    "role": "client"
  }
}

script:post-response {
  // Test script to validate response
  test("Status code is 201 Created", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  test("Response has success field", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(true);
  });
  
  test("Response contains user data", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('user');
      expect(jsonData.data.user).to.have.property('id');
      expect(jsonData.data.user).to.have.property('email');
      expect(jsonData.data.user).to.have.property('firstName');
      expect(jsonData.data.user).to.have.property('lastName');
      expect(jsonData.data.user).to.have.property('role');
  });
  
  test("Password is not returned", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.user).to.not.have.property('password');
  });
  
  test("User ID is a UUID", function () {
      var jsonData = res.getBody();
      var uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
      expect(jsonData.data.user.id).to.match(uuidPattern);
  });
  
  // Save user email for login
  var jsonData = res.getBody();
  if (jsonData.data && jsonData.data.user) {
      bru.setVar("user_email", jsonData.data.user.email);
      console.log("✅ User registered successfully:", jsonData.data.user.email);
  }
}

settings {
  encodeUrl: true
}

docs {
  **Register a new user account**
  
  ### Request Body:
  - `email` (string, required): User's email address
  - `password` (string, required): Password (min 8 characters)
  - `firstName` (string, required): User's first name
  - `lastName` (string, required): User's last name
  - `role` (string, optional): User role - "client", "gym_owner", or "super_admin" (defaults to "client")
  
  ### Success Response (201):
  ```json
  {
    "success": true,
    "message": "User registered successfully",
    "data": {
      "user": {
        "id": "uuid",
        "email": "john.doe@tspark.com",
        "firstName": "John",
        "lastName": "Doe",
        "role": "client",
        "status": "active",
        "emailVerified": false,
        "totalPoints": 0,
        "createdAt": "2024-01-19T...",
        "updatedAt": "2024-01-19T..."
      }
    }
  }
  ```
  
  ### Error Responses:
  - **400**: Missing required fields or invalid format
  - **409**: Email already exists
  - **500**: Server error
  
  ### Security:
  - Password is hashed with bcrypt before storage
  - Password is NEVER returned in response
}
