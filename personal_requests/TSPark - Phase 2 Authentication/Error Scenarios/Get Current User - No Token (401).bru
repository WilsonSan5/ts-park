meta {
  name: Get Current User - No Token (401)
  type: http
  seq: 7
}

get {
  url: {{base_url}}/auth/me
  body: none
  auth: inherit
}

script:post-response {
  test("Status code is 401 Unauthorized", function () {
      expect(res.getStatus()).to.equal(401);
  });
  
  test("Response indicates token required", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(false);
      expect(jsonData.message).to.include('token');
  });
  
  console.log("✅ Missing token correctly rejected");
}

settings {
  encodeUrl: true
}

docs {
  **Test protected route without authentication token**
  
  ### Expected Behavior:
  - Status: 401 Unauthorized
  - Message: "Access token is required"
  - Middleware blocks request before reaching controller
  
  ### How It Works:
  1. Request arrives without Authorization header
  2. `authenticateToken` middleware checks for header
  3. No header found → sends 401 error
  4. Controller never runs
  
  ### Security:
  Protected routes are inaccessible without valid authentication.
}
