meta {
  name: Change Password
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/users/{{user_id}}/password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "currentPassword": "SecurePass123",
    "newPassword": "NewSecurePass123"
  }
}

script:post-response {
  test("Status code is 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Password changed successfully", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(true);
      expect(jsonData.message).to.include('Password changed');
  });
  
  console.log("✅ Password changed successfully");
}

settings {
  encodeUrl: true
}

docs {
  **Change user password**
  
  **Requirements:**
  - Must provide current password
  - New password must be 8+ characters
  - Can only change own password (not even admin)
  
  **Security:**
  - Verifies current password before changing
  - New password is hashed with bcrypt
}
