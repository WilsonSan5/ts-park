meta {
  name: Register - Invalid Email (400)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "not-an-email",
    "password": "SecurePass123",
    "firstName": "Test",
    "lastName": "User"
  }
}

script:post-response {
  test("Status code is 400 Bad Request", function () {
      expect(res.getStatus()).to.equal(400);
  });
  
  test("Response indicates invalid email", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(false);
      expect(jsonData.message).to.include('email');
  });
  
  console.log("✅ Invalid email format correctly rejected");
}

settings {
  encodeUrl: true
}

docs {
  **Test registration with invalid email format**
  
  Email without @ symbol should return 400 Bad Request.
  
  ### Expected Behavior:
  - Status: 400 Bad Request
  - Message: "Invalid email format"
  - No user created
  
  ### Validation:
  Controller uses regex to validate email format:
  ```javascript
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  ```
}
