meta {
  name: Lister les Défis avec Filtres
  type: http
  seq: 3
}

get {
  url: {{base_url}}/challenges?difficulty=medium&type=individual
  body: none
  auth: inherit
}

params:query {
  difficulty: medium
  type: individual
}

headers {
  Authorization: Bearer {{gym_owner_token}}
}

script:post-response {
  test("Filtrage fonctionnel", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Défis filtrés correctement", function () {
      var jsonData = res.getBody();
      jsonData.data.forEach(function(challenge) {
          expect(challenge.difficulty).to.eql('medium');
          expect(challenge.type).to.eql('individual');
      });
  });
  
  console.log("🔍 Défis filtrés:", res.getBody().data.length);
}

settings {
  encodeUrl: true
}

docs {
  Lister les défis avec filtres de difficulté et type
}
