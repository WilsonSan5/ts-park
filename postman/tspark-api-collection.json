                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"30-Day Strength Challenge\",\n  \"description\": \"Build muscle and strength over 30 days with our structured workout program.\",\n  \"type\": \"individual\",\n  \"difficulty\": \"medium\",\n  \"objectives\": {\n    \"targetWorkouts\": 20,\n    \"targetCalories\": 5000,\n    \"targetDuration\": 600\n  },\n  \"startDate\": \"2025-12-20T00:00:00Z\",\n  \"endDate\": \"2026-01-20T23:59:59Z\",\n  \"pointsReward\": 500,\n  \"isPublic\": true,\n  \"maxParticipants\": 100,\n  \"gymId\": \"{{gymId}}\",\n  \"recommendedExerciseIds\": [\"{{exerciseId}}\"]\n}"
                }
