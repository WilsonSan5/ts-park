meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "john.doe@tspark.com",
    "password": "SecurePass123"
  }
}

script:post-response {
  // Test script to validate response and save token
  test("Status code is 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has success field", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(true);
  });
  
  test("Response contains user and token", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('user');
      expect(jsonData.data).to.have.property('token');
  });
  
  test("Token is a valid JWT format", function () {
      var jsonData = res.getBody();
      var jwtPattern = /^[A-Za-z0-9-_]+\.[A-Za-z0-9-_]+\.[A-Za-z0-9-_]+$/;
      expect(jsonData.data.token).to.match(jwtPattern);
  });
  
  test("Password is not returned", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.user).to.not.have.property('password');
  });
  
  // Save token to collection variable for use in protected routes
  var jsonData = res.getBody();
  if (jsonData.data && jsonData.data.token) {
      bru.setVar("auth_token", jsonData.data.token);
      console.log("✅ Login successful! Token saved to collection variables.");
      console.log("🔑 Token:", jsonData.data.token.substring(0, 20) + "...");
  }
}

settings {
  encodeUrl: true
}

docs {
  **Authenticate user and get JWT token**
  
  ### Request Body:
  - `email` (string, required): User's email address
  - `password` (string, required): User's password
  
  ### Success Response (200):
  ```json
  {
    "success": true,
    "message": "Login successful",
    "data": {
      "user": {
        "id": "uuid",
        "email": "john.doe@tspark.com",
        "firstName": "John",
        "lastName": "Doe",
        "role": "client",
        "status": "active",
        "totalPoints": 0,
        ...
      },
      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
    }
  }
  ```
  
  ### Error Responses:
  - **400**: Missing email or password
  - **401**: Invalid credentials or inactive account
  - **500**: Server error
  
  ### Token Usage:
  - Token expires in 24 hours
  - Use in Authorization header: `Bearer <token>`
  - Token contains: userId, email, role
  
  ### What Happens:
  1. Server finds user by email
  2. Compares password with bcrypt hash
  3. Checks account status is "active"
  4. Generates signed JWT token
  5. Returns user data + token
  
  ### Security:
  - Password is never stored or returned
  - Error messages don't reveal if email exists
  - Token is cryptographically signed
}
