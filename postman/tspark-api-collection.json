    {
      "name": "💪 2. Exercises (Super Admin Only)",
      "description": "Exercise CRUD operations. Only Super Admins can create/update/delete exercises.",
      "item": [
        {
          "name": "2.1 Create Exercise",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('exerciseId', jsonData.data.id || jsonData.data.exercise.id);",
                  "    console.log('Exercise created with ID:', pm.collectionVariables.get('exerciseId'));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superAdminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/exercises",
              "host": ["{{base_url}}"],
              "path": ["exercises"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Barbell Squat\",\n  \"description\": \"Compound lower body exercise targeting quads, glutes, and hamstrings. Essential for building lower body strength.\",\n  \"type\": \"strength\",\n  \"difficulty\": \"intermediate\",\n  \"muscleGroup\": \"legs\",\n  \"equipment\": \"barbell\",\n  \"instructions\": [\n    \"Stand with feet shoulder-width apart\",\n    \"Place barbell on upper back (trapezius)\",\n    \"Bend knees and lower hips until thighs are parallel to ground\",\n    \"Keep chest up and back straight throughout\",\n    \"Push through heels to return to standing\"\n  ],\n  \"caloriesPerMinute\": 8,\n  \"videoUrl\": \"https://example.com/squat-tutorial\"\n}"
            },
            "description": "**Requires Super Admin token!**\n\nCreates a new exercise in the platform.\n\n**Auto-saves exercise ID** to `{{exerciseId}}`"
          },
          "response": []
        },
