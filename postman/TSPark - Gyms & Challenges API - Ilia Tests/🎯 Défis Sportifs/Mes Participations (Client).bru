meta {
  name: Mes Participations (Client)
  type: http
  seq: 7
}

get {
  url: {{base_url}}/challenges/participations
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{client_token}}
}

script:post-response {
  test("Participations récupérées", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Au moins une participation", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.be.an('array');
      expect(jsonData.data.length).to.be.at.least(1);
  });
  
  console.log("📋 Mes participations:", res.getBody().data.length);
}

settings {
  encodeUrl: true
}

docs {
  Voir toutes les participations de l'utilisateur actuel
}
