meta {
  name: Get Current User (Protected)
  type: http
  seq: 3
}

get {
  url: {{base_url}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

script:post-response {
  // Test script for protected route
  test("Status code is 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has success field", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(true);
  });
  
  test("Response contains user data", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('user');
      expect(jsonData.data.user).to.have.property('id');
      expect(jsonData.data.user).to.have.property('email');
  });
  
  test("Password is not returned", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.user).to.not.have.property('password');
  });
  
  console.log("✅ Protected route accessed successfully!");
  console.log("👤 User:", res.getBody().data.user.email);
}

settings {
  encodeUrl: true
}

docs {
  **Get current authenticated user's profile**
  
  ### Authentication:
  **REQUIRED** - This is a protected route
  - Header: `Authorization: Bearer <token>`
  - Token obtained from login endpoint
  
  ### Success Response (200):
  ```json
  {
    "success": true,
    "message": "User profile retrieved successfully",
    "data": {
      "user": {
        "id": "uuid",
        "email": "john.doe@tspark.com",
        "firstName": "John",
        "lastName": "Doe",
        "role": "client",
        "status": "active",
        "emailVerified": false,
        "totalPoints": 0,
        "createdAt": "2024-01-19T...",
        "updatedAt": "2024-01-19T..."
      }
    }
  }
  ```
  
  ### Error Responses:
  - **401**: No token provided or invalid token format
  - **403**: Token expired or invalid signature
  - **404**: User not found (token valid but user deleted)
  - **500**: Server error
  
  ### How It Works:
  1. Client sends request with JWT in Authorization header
  2. `authenticateToken` middleware extracts token
  3. Middleware verifies token signature and expiration
  4. Middleware adds `req.user = { userId, email, role }`
  5. Controller fetches fresh user data from database
  6. Returns complete user profile
  
  ### Why Get Fresh Data?
  - Token might be old (issued hours ago)
  - User data might have changed (points, status, etc.)
  - This ensures you have current information
  
  ### Token Auto-Used:
  This request automatically uses the token saved from the Login request.
}
