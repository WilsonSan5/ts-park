meta {
  name: Register - Utilisateur Normal
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "nouveauclient@tspark.com",
    "password": "SecurePass123",
    "firstName": "Jean",
    "lastName": "Dupont",
    "role": "client"
  }
}

script:post-response {
  test("Inscription réussie", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  test("Utilisateur créé", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('user');
      expect(jsonData.data.user).to.have.property('id');
      expect(jsonData.data.user).to.have.property('email');
  });
  
  // Sauvegarder les infos du nouvel utilisateur
  var jsonData = res.getBody();
  if (jsonData.data && jsonData.data.user) {
      bru.setVar("new_user_email", jsonData.data.user.email);
      bru.setVar("new_user_id", jsonData.data.user.id);
      console.log("✅ Utilisateur inscrit:", jsonData.data.user.email);
      console.log("🆔 ID:", jsonData.data.user.id);
  }
}

settings {
  encodeUrl: true
}

docs {
  Inscription d'un nouvel utilisateur avec le rôle client
}
