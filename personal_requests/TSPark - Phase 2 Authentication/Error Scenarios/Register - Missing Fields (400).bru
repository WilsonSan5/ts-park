meta {
  name: Register - Missing Fields (400)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "incomplete@tspark.com",
    "password": "SecurePass123"
  }
}

script:post-response {
  test("Status code is 400 Bad Request", function () {
      expect(res.getStatus()).to.equal(400);
  });
  
  test("Response indicates missing fields", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(false);
      expect(jsonData.message).to.include('required');
  });
  
  console.log("✅ Missing fields correctly rejected");
}

settings {
  encodeUrl: true
}

docs {
  **Test registration with missing required fields**
  
  Missing firstName and lastName should return 400 Bad Request.
  
  ### Expected Behavior:
  - Status: 400 Bad Request
  - Message: "All fields are required (email, password, firstName, lastName)"
  - No user created
  
  ### Validation:
  Controller validates all required fields are present before calling the service.
}
