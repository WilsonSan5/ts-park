meta {
  name: Delete User - Not Admin (403)
  type: http
  seq: 5
}

delete {
  url: {{base_url}}/users/{{user_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

script:post-response {
  test("Status code is 403 Forbidden", function () {
      expect(res.getStatus()).to.equal(403);
  });
  
  console.log("✅ Non-admin correctly blocked from deleting users");
}

settings {
  encodeUrl: true
}

docs {
  **Test non-admin trying to delete a user**
  
  Expected: 403 Forbidden
}
