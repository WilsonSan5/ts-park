meta {
  name: Lister Tous les Utilisateurs (Admin)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/users
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{admin_token}}
}

script:post-response {
  test("Liste utilisateurs récupérée", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Réponse contient la liste des utilisateurs", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('users');
      expect(jsonData.data.users).to.be.an('array');
  });
  
  test("Pas de mots de passe dans la réponse", function () {
      var jsonData = res.getBody();
      jsonData.data.users.forEach(user => {
          expect(user).to.not.have.property('password');
      });
  });
  
  console.log("👥 Utilisateurs listés:", res.getBody().data.users.length);
}

settings {
  encodeUrl: true
}

docs {
  Lister tous les utilisateurs (super_admin uniquement)
}
