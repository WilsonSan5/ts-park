meta {
  name: Lister Tous les Exercices
  type: http
  seq: 2
}

get {
  url: {{base_url}}/exercises
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{gym_owner_token}}
}

script:post-response {
  test("Liste récupérée", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Réponse est un objet avec exercices", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('exercises');
      expect(jsonData.data.exercises).to.be.an('array');
  });
  
  console.log("📋 Nombre d'exercices trouvés:", res.getBody().data.exercises.length);
}

settings {
  encodeUrl: true
}

docs {
  Lister tous les exercices disponibles
}
