meta {
  name: List All Users (Admin Only)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

script:post-response {
  test("Status code is 200 OK", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response contains users array", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('users');
      expect(jsonData.data.users).to.be.an('array');
  });
  
  test("No passwords in response", function () {
      var jsonData = res.getBody();
      jsonData.data.users.forEach(user => {
          expect(user).to.not.have.property('password');
      });
  });
  
  console.log("✅ Users list retrieved:", res.getBody().data.users.length, "users");
}

settings {
  encodeUrl: true
}

docs {
  **List all users (Super Admin only)**
  
  Returns all users without passwords.
  
  **Authorization:**
  - Requires Super Admin role
  - Returns 403 if not Super Admin
}
