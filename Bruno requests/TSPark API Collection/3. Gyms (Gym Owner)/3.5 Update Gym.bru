meta {
  name: 3.5 Update Gym
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/gyms/{{gymId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{gymOwnerToken}}
  Content-Type: application/json
}

body:json {
  {
    "description": "Updated: Premium fitness center with 24/7 access and personal training.",
    "openingHours": "24/7 Access with key card"
  }
}

settings {
  encodeUrl: true
}

docs {
  Update gym details. Only owner or super_admin can update.
}
