meta {
  name: Register - Duplicate Email (409)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "john.doe@tspark.com",
    "password": "SecurePass123",
    "firstName": "John",
    "lastName": "Doe"
  }
}

script:post-response {
  test("Status code is 409 Conflict", function () {
      expect(res.getStatus()).to.equal(409);
  });
  
  test("Response indicates email exists", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(false);
      expect(jsonData.message).to.include('already exists');
  });
  
  console.log("✅ Duplicate email correctly rejected");
}

settings {
  encodeUrl: true
}

docs {
  **Test duplicate email registration**
  
  Trying to register with an email that already exists should return 409 Conflict.
  
  ### Expected Behavior:
  - Status: 409 Conflict
  - Message: "User with this email already exists"
  - No user created in database
  
  ### Security Note:
  Revealing that an email exists could be a privacy concern, but for registration it's acceptable as users need to know if they already have an account.
}
