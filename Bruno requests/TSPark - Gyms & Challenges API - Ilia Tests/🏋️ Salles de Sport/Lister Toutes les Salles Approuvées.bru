meta {
  name: Lister Toutes les Salles Approuvées
  type: http
  seq: 2
}

get {
  url: {{base_url}}/gyms
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{gym_owner_token}}
}

script:post-response {
  test("Liste récupérée", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Réponse est un tableau", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.be.an('array');
  });
  
  test("Toutes les salles sont approuvées", function () {
      var jsonData = res.getBody();
      jsonData.data.forEach(function(gym) {
          expect(gym.status).to.eql('approved');
      });
  });
  
  console.log("📋 Nombre de salles approuvées:", res.getBody().data.length);
}

settings {
  encodeUrl: true
