meta {
  name: Modifier une Salle
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/gyms/{{new_gym_id}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{gym_owner_token}}
}

body:json {
  {
    "description": "MISE À JOUR : Salle de sport moderne avec équipements haut de gamme, coachs professionnels et nouveau studio de yoga !",
    "capacity": 150,
    "equipment": ["Tapis de course", "Vélos elliptiques", "Poids libres", "Machines guidées", "Espace stretching", "Studio yoga"]
  }
}

script:post-response {
  test("Modification réussie", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Données mises à jour", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.description).to.include('MISE À JOUR');
  });
  
  console.log("✏️ Salle modifiée:", res.getBody().data.name);
}

settings {
  encodeUrl: true
}

docs {
  Modifier les détails d'une salle (propriétaire ou super_admin uniquement)
}
