meta {
  name: Change Password - Wrong Current Password (400)
  type: http
  seq: 3
}

patch {
  url: {{base_url}}/users/{{user_id}}/password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "currentPassword": "WrongPassword",
    "newPassword": "NewPassword123"
  }
}

script:post-response {
  test("Status code is 400 Bad Request", function () {
      expect(res.getStatus()).to.equal(400);
  });
  
  test("Error message about wrong password", function () {
      var jsonData = res.getBody();
      expect(jsonData.message).to.include('Current password is incorrect');
  });
  
  console.log("✅ Wrong current password rejected");
}

settings {
  encodeUrl: true
}

docs {
  **Test password change with wrong current password**
  
  Expected: 400 Bad Request
}
