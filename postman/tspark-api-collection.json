{
  "info": {
    "name": "TSPark API Collection",
    "description": "Complete API collection for TSPark fitness challenge platform. Includes authentication, user management, gyms, exercises, challenges, workouts, and social features.\n\n## Testing Order\n1. Start with '1. Setup' folder - Register users and login\n2. Proceed to '2. Exercises' - Create exercises (Super Admin)\n3. Then '3. Gyms' - Create and manage gyms (Gym Owner)\n4. Then '4. Challenges' - Create challenges (Gym Owner)\n5. Then '5. Workouts' - Log workouts (Client)\n6. Finally '6. Social' - Friend features (All users)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "superAdminToken",
      "value": "",
      "type": "string",
      "description": "JWT token for super admin user"
    },
    {
      "key": "gymOwnerToken",
      "value": "",
      "type": "string",
      "description": "JWT token for gym owner user"
    },
    {
      "key": "clientToken",
      "value": "",
      "type": "string",
      "description": "JWT token for client user"
    },
    {
      "key": "client2Token",
      "value": "",
      "type": "string",
      "description": "JWT token for second client (for friend testing)"
    },
    {
      "key": "gymId",
      "value": "",
      "type": "string"
    },
    {
      "key": "exerciseId",  
      "value": "",
      "type": "string"
    },
    {
      "key": "challengeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "client2UserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "friendshipId",
      "value": "",
      "type": "string"
    }
  ],
