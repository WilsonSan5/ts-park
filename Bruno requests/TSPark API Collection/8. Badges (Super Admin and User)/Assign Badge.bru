meta {
  name: Assign Badge
  type: http
  seq: 2
}

post {
  url: {{base_url}}/badges/assign
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{superAdminToken}}
}

body:json {
  {
    "badgeId": "{{badgeId}}",
    "userId": "{{clientUserId}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
