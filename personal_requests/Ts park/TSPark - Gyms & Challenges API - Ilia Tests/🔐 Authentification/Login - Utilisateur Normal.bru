meta {
  name: Login - Utilisateur Normal
  type: http
  seq: 3
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "user@tspark.com",
    "password": "SecurePass123"
  }
}

script:post-response {
  test("Connexion réussie", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Token reçu", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('token');
  });
  
  // Sauvegarder le token utilisateur
  var jsonData = res.getBody();
  if (jsonData.data && jsonData.data.token) {
      bru.setVar("user_token", jsonData.data.token);
      bru.setVar("user_id", jsonData.data.user.id);
      console.log("✅ Connecté comme:", jsonData.data.user.email);
      console.log("🔑 Token sauvegardé");
  }
}

settings {
  encodeUrl: true
}

docs {
  Connexion d'un utilisateur standard
}
