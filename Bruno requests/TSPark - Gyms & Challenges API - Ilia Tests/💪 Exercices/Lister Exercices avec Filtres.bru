meta {
  name: Lister Exercices avec Filtres
  type: http
  seq: 3
}

get {
  url: {{base_url}}/exercises?difficulty=advanced&muscleGroup=pectoraux
  body: none
  auth: inherit
}

params:query {
  difficulty: advanced
  muscleGroup: pectoraux
}

headers {
  Authorization: Bearer {{gym_owner_token}}
}

script:post-response {
  test("Filtrage fonctionnel", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Exercices filtrés correctement", function () {
      var jsonData = res.getBody();
      jsonData.data.exercises.forEach(function(exercise) {
          expect(exercise.difficulty).to.eql('advanced');
      });
  });
  
  console.log("🔍 Exercices filtrés:", res.getBody().data.exercises.length);
}

settings {
  encodeUrl: true
}

docs {
  Lister les exercices avec filtres de difficulté et groupe musculaire
}
