meta {
  name: 2.6 Update Exercise (Super Admin)
  type: http
  seq: 6
}

patch {
  url: {{base_url}}/exercises/{{exerciseId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{superAdminToken}}
  Content-Type: application/json
}

body:json {
  {
    "description": "Updated: The king of lower body exercises. Builds strength, muscle, and functional fitness.",
    "caloriesPerMinute": 10
  }
}

settings {
  encodeUrl: true
}

docs {
  **Requires Super Admin token!**
  
  Update exercise details.
}
