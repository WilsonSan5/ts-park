    {
      "name": "🤝 6. Social / Friends",
      "description": "Friend management. Send requests, accept/reject, and manage friendships.",
      "item": [
        {
          "name": "6.1 Send Friend Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.collectionVariables.set('friendshipId', jsonData.data.id);",
                  "        console.log('Friendship request created with ID:', jsonData.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/friends/request",
              "host": ["{{base_url}}"],
              "path": ["friends", "request"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addresseeId\": \"{{client2UserId}}\"\n}"
            },
            "description": "**Client 1 sends friend request to Client 2**\n\nUses `{{client2UserId}}` - make sure Client 2 is registered first!"
          },
          "response": []
        },
        {
          "name": "6.2 List Pending Requests (Client 2)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client2Token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/friends/pending",
              "host": ["{{base_url}}"],
              "path": ["friends", "pending"]
            },
            "description": "**As Client 2**, view pending friend requests received."
          },
          "response": []
        },
        {
          "name": "6.3 List Sent Requests (Client 1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/friends/sent",
              "host": ["{{base_url}}"],
              "path": ["friends", "sent"]
            },
            "description": "**As Client 1**, view friend requests you've sent."
          },
          "response": []
        },
        {
          "name": "6.4 Accept Friend Request (Client 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{client2Token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/friends/{{friendshipId}}/accept",
              "host": ["{{base_url}}"],
              "path": ["friends", "{{friendshipId}}", "accept"]
            },
            "description": "**As Client 2**, accept the pending friend request.\n\nUses `{{friendshipId}}` from the sent request."
          },
          "response": []
        },
        {
          "name": "6.5 List Friends (Client 1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/friends",
              "host": ["{{base_url}}"],
              "path": ["friends"]
            },
            "description": "View all accepted friends."
          },
