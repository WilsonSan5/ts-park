meta {
  name: Update Email - Duplicate (409)
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/users/{{user_id}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{auth_token}}
}

body:json {
  {
    "email": "admin@tspark.com"
  }
}

script:post-response {
  test("Status code is 409 Conflict", function () {
      expect(res.getStatus()).to.equal(409);
  });
  
  test("Duplicate email error", function () {
      var jsonData = res.getBody();
      expect(jsonData.message).to.include('already in use');
  });
  
  console.log("✅ Duplicate email correctly rejected");
}

settings {
  encodeUrl: true
}

docs {
  **Test updating email to one that already exists**
  
  Expected: 409 Conflict
}
