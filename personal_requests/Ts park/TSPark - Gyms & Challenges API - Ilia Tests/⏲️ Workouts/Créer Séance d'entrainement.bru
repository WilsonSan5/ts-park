meta {
  name: Créer Séance d'entrainement
  type: http
  seq: 1
}

post {
  url: {{base_url}}/workouts
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{client_token}}
}

body:json {
  {
    "name": "Pecs, épaule, triceps",
    "description": "À faire 2 fois par semaine pour muscler le haut du corps.",
    "duration": 70,
    "exercices": [
      {
      "exerciseIds" : "073e41bc-129a-4c27-a026-442077fb6af3",
      "repetitions": 8,
      "sets": 3 ,
      "restPeriods": 90,
      "weight": 18
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
