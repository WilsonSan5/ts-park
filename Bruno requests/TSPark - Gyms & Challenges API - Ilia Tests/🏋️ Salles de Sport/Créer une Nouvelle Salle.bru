meta {
  name: Créer une Nouvelle Salle
  type: http
  seq: 1
}

post {
  url: {{base_url}}/gyms
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{gym_owner_token}}
}

body:json {
  {
    "name": "PowerGym Paris 15",
    "description": "Salle de sport moderne avec équipements haut de gamme et coachs professionnels",
    "address": "15 Rue de Vaugirard",
    "city": "Paris",
    "phone": "01.45.67.89.10",
    "email": "contact@powergym-paris15.fr",
    "capacity": 120,
    "equipment": [
      "Tapis de course",
      "Vélos elliptiques",
      "Poids libres",
      "Machines guidées",
      "Espace stretching"
    ],
    "specializedExerciseTypes": [
      "cardio",
      "musculation",
      "fitness"
    ]
  }
}

script:post-response {
  test("Salle créée avec succès", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  test("Données de la salle reçues", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('id');
      expect(jsonData.data).to.have.property('name');
      expect(jsonData.data.status).to.eql('pending');
  });
  
  // Sauvegarder l'ID de la salle
  var jsonData = res.getBody();
  if (jsonData.data && jsonData.data.id) {
      bru.setVar("new_gym_id", jsonData.data.id);
      console.log("✅ Salle créée avec l'ID:", jsonData.data.id);
      console.log("📝 Statut:", jsonData.data.status);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Créer une nouvelle salle de sport (nécessite le rôle gym_owner)
}
