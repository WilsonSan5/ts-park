meta {
  name: Détails d'un Exercice
  type: http
  seq: 5
}

get {
  url: {{base_url}}/exercises/{{exercise_id}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{client_token}}
}

script:post-response {
  test("Détails récupérés", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Données complètes de l'exercice", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('id');
      expect(jsonData.data).to.have.property('name');
      expect(jsonData.data).to.have.property('instructions');
      expect(jsonData.data).to.have.property('createdBy');
  });
  
  console.log("💪 Exercice:", res.getBody().data.name);
}

settings {
  encodeUrl: true
}

docs {
  Obtenir les détails complets d'un exercice spécifique
}
