meta {
  name: Créer un Nouvel Exercice (Super Admin)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/exercises
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{admin_token}}
}

body:json {
  {
    "name": "Pompes Diamant",
    "description": "Variation difficile des pompes traditionnelles avec les mains en forme de diamant",
    "muscleGroups": ["pectoraux", "triceps", "épaules"],
    "difficulty": "advanced",
    "caloriesPerMinute": 8.5,
    "instructions": "Placez vos mains en forme de diamant sous votre poitrine, descendez et remontez en contrôlant le mouvement",
    "videoUrl": "https://example.com/pompes-diamant.mp4",
    "imageUrl": "https://example.com/pompes-diamant.jpg"
  }
}

script:post-response {
  test("Exercice créé avec succès", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  test("Données de l'exercice reçues", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('id');
      expect(jsonData.data).to.have.property('name');
      expect(jsonData.data).to.have.property('difficulty');
  });
  
  // Sauvegarder l'ID de l'exercice
  var jsonData = res.getBody();
  if (jsonData.data && jsonData.data.id) {
      bru.setVar("exercise_id", jsonData.data.id);
      console.log("✅ Exercice créé avec l'ID:", jsonData.data.id);
      console.log("💪 Nom:", jsonData.data.name);
  }
}

settings {
  encodeUrl: true
}

docs {
  Créer un nouvel exercice (super_admin uniquement)
}
