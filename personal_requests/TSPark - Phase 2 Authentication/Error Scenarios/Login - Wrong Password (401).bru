meta {
  name: Login - Wrong Password (401)
  type: http
  seq: 5
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "john.doe@tspark.com",
    "password": "WrongPassword123"
  }
}

script:post-response {
  test("Status code is 401 Unauthorized", function () {
      expect(res.getStatus()).to.equal(401);
  });
  
  test("Response indicates invalid credentials", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(false);
      expect(jsonData.message).to.include('Invalid');
  });
  
  console.log("✅ Wrong password correctly rejected");
}

settings {
  encodeUrl: true
}

docs {
  **Test login with incorrect password**
  
  ### Expected Behavior:
  - Status: 401 Unauthorized
  - Message: "Invalid email or password"
  - No token generated
  
  ### Security Note:
  We don't reveal whether the email exists or the password is wrong. This prevents attackers from discovering valid email addresses.
}
