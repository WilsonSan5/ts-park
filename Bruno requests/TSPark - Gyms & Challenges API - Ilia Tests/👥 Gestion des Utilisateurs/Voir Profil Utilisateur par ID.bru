meta {
  name: Voir Profil Utilisateur par ID
  type: http
  seq: 2
}

get {
  url: {{base_url}}/users/{{gym_owner_id}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{gym_owner_token}}
}

script:post-response {
  test("Profil récupéré", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Données utilisateur complètes", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('user');
      expect(jsonData.data.user).to.have.property('email');
  });
  
  test("Pas de mot de passe", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.user).to.not.have.property('password');
  });
  
  console.log("👤 Profil utilisateur récupéré");
}

settings {
  encodeUrl: true
}

docs {
  Voir son propre profil ou celui d'un autre utilisateur (admin)
}
