meta {
  name: Get Current User - Invalid Token (403)
  type: http
  seq: 8
}

get {
  url: {{base_url}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: invalid.token.here
}

script:post-response {
  test("Status code is 403 Forbidden", function () {
      expect(res.getStatus()).to.equal(403);
  });
  
  test("Response indicates invalid token", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(false);
      expect(jsonData.message).to.include('Invalid');
  });
  
  console.log("✅ Invalid token correctly rejected");
}

settings {
  encodeUrl: true
}

docs {
  **Test protected route with invalid JWT token**
  
  ### Expected Behavior:
  - Status: 403 Forbidden
  - Message: "Invalid or expired token"
  - Middleware blocks request
  
  ### How It Works:
  1. Request arrives with invalid token
  2. `authenticateToken` middleware tries to verify token
  3. `verifyToken()` throws error (invalid signature)
  4. Middleware catches error → sends 403
  5. Controller never runs
  
  ### Token Verification:
  - Checks signature matches JWT_SECRET
  - Validates token structure
  - Checks expiration timestamp
  - Ensures token hasn't been tampered with
}
