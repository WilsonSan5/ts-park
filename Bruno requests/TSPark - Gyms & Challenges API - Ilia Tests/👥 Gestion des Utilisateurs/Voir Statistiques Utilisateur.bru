meta {
  name: Voir Statistiques Utilisateur
  type: http
  seq: 6
}

get {
  url: {{base_url}}/users/{{client_id}}/stats
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{client_token}}
}

script:post-response {
  test("Statistiques récupérées", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Données statistiques présentes", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('totalPoints');
      expect(jsonData.data).to.have.property('memberSince');
  });
  
  var stats = res.getBody().data;
  console.log("📊 Statistiques:");
  console.log("🎯 Points totaux:", stats.totalPoints);
  console.log("📅 Membre depuis:", stats.memberSince);
}

settings {
  encodeUrl: true
}

docs {
  Voir ses propres statistiques ou celles d'un autre utilisateur (admin)
}
