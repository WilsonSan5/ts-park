meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/register
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "john.doe@tspark.com",
    "password": "SecurePass123",
    "firstName": "John",
    "lastName": "Doe",
    "role": "client"
  }
}

script:post-response {
  test("Status code is 201 Created", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  test("Response has success field", function () {
      var jsonData = res.getBody();
      expect(jsonData.success).to.eql(true);
  });
  
  test("Response contains user data", function () {
      var jsonData = res.getBody();
      expect(jsonData.data).to.have.property('user');
      expect(jsonData.data.user).to.have.property('id');
  });
  
  test("Password is not returned", function () {
      var jsonData = res.getBody();
      expect(jsonData.data.user).to.not.have.property('password');
  });
  
  var jsonData = res.getBody();
  if (jsonData.data && jsonData.data.user) {
      bru.setVar("user_id", jsonData.data.user.id);
      bru.setVar("user_email", jsonData.data.user.email);
      console.log("✅ User registered:", jsonData.data.user.email);
      console.log("💾 User ID saved:", jsonData.data.user.id);
  }
}

settings {
  encodeUrl: true
}

docs {
  **Register a new user account**
  
  Request Body:
  - `email` (required): User's email
  - `password` (required): Min 8 characters
  - `firstName` (required): First name
  - `lastName` (required): Last name
  - `role` (optional): client/gym_owner/super_admin
}
