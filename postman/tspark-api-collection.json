            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Push-ups\",\n  \"description\": \"Classic bodyweight exercise for upper body strength. Targets chest, shoulders, and triceps.\",\n  \"type\": \"strength\",\n  \"difficulty\": \"beginner\",\n  \"muscleGroup\": \"chest\",\n  \"equipment\": \"none\",\n  \"instructions\": [\n    \"Start in plank position with hands shoulder-width apart\",\n    \"Lower body until chest nearly touches the ground\",\n    \"Keep core tight and body in a straight line\",\n    \"Push back up to starting position\",\n    \"Repeat for desired reps\"\n  ],\n  \"caloriesPerMinute\": 7,\n  \"imageUrl\": \"https://example.com/pushups.jpg\"\n}"
            },
            "description": "Creates another exercise for variety."
          },
          "response": []
